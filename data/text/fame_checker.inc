PokemonJournal_Text_SpecialFeatureBrock::
	.string "宝可梦特刊\p"
	.string "专题：深灰道馆\n"
	.string "馆主小刚！\p"
	.string "小刚几乎不怎么笑，\n"
	.string "但是据说他笑起来就停不下。$"

PokemonJournal_Text_SpecialFeatureMisty::
	.string "宝可梦特刊\p"
	.string "专题：华蓝道馆\n"
	.string "馆主小霞！\p"
	.string "据说，小霞很崇拜四天王\n"
	.string "的科拿。$"

PokemonJournal_Text_SpecialFeatureLtSurge::
	.string "宝可梦特刊\p"
	.string "专题：枯叶道馆\n"
	.string "馆主马志士！\p"
	.string "据说马志士在美国做过\n"
	.string "飞行员。\p"
	.string "他用宝可梦所发的电\n"
	.string "驱动飞机。$"

PokemonJournal_Text_SpecialFeatureErika::
	.string "宝可梦特刊\p"
	.string "专题：玉虹道馆\n"
	.string "馆主莉佳！\p"
	.string "据说：如果你经常偷窥玉虹道馆，\n"
	.string "那你就会看到，\l"
	.string "莉佳打瞌睡的情景。$"

PokemonJournal_Text_SpecialFeatureKoga::
	.string "宝可梦特刊\p"
	.string "专题：浅红道馆\n"
	.string "馆主阿桔！\p"
	.string "据说阿桔在医药方面\n"
	.string "有很深厚的知识功底。\p"
	.string "据说他用自己所配的药方\n"
	.string "治疗自己的宝可梦。$"

PokemonJournal_Text_SpecialFeatureSabrina::
	.string "宝可梦特刊\p"
	.string "专题：金黄道馆\n"
	.string "馆主娜姿！\p"
	.string "人们说，娜姿在战斗中，\n"
	.string "可以不动声色地\l"
	.string "用超能力与宝可梦交流。$"

PokemonJournal_Text_SpecialFeatureBlaine::
	.string "宝可梦特刊\p"
	.string "专题：红莲道馆\n"
	.string "馆主夏伯！\p"
	.string "据说夏伯仅仅会在想出\n"
	.string "问题的答案后\l"
	.string "摘下黑眼睛。$"

PokemonJournal_Text_SpecialFeatureLorelei::
	.string "宝可梦特刊\p"
	.string "专题：\n"
	.string "四天王的科拿！\p"
	.string "由于她的强大、有逻辑的头脑，\n"
	.string "以及冷静的对战方式，科拿\l"
	.string "一直都是一个谜！$"

PokemonJournal_Text_SpecialFeatureBruno::
	.string "宝可梦特刊\p"
	.string "专题：\n"
	.string "四天王的希巴！\p"
	.string "显然，希巴加入天王\n"
