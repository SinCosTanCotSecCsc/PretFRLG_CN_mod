gFameCheckerPersonQuote_Lance:: @ 0x81B098B
	.string "{COLOR 0x08}{SHADOW 0x09}阿渡 (寄) \n"
	.string "{PLAYER} (收) \p"
	.string "{FONT_MALE}{COLOR 0x02}{SHADOW 0x03}我现在在考虑\n"
	.string "返回我的故乡。\p"
	.string "我想去再训练我的龙属性\n"
	.string "宝可梦并加强它们的战斗力。\n"
	.string "希望我有一天\n"
	.string "能正式邀请你到我家乡看看。$"

gFameCheckerPersonName_Bill:: @ 0x81B0A45
	.string "{COLOR 0x08}{SHADOW 0x09}正辉$"

gFameCheckerPersonQuote_Bill:: @ 0x81B0A50
	.string "{COLOR 0x08}{SHADOW 0x09}正辉 (寄) \n"
	.string "{PLAYER} (收) \p"
	.string "{FONT_MALE}{COLOR 0x02}{SHADOW 0x03}哟，好久不见！阿锦除了夸你之外\n"
	.string "再没有做过其它的什么了。\p"
	.string "我听到后感到非常的高兴。\p"
	.string "当你抓到珍贵的宝可梦时，\n"
	.string "记得要带来让我看，可以吗？约好了哦！$"

gFameCheckerPersonName_MrFuji:: @ 0x81B0AFF
	.string "{COLOR 0x08}{SHADOW 0x09}富士老人$"

gFameCheckerPersonQuote_MrFuji:: @ 0x81B0B0E
	.string "{COLOR 0x08}{SHADOW 0x09}富士老人 (寄) \n"
	.string "{PLAYER} (收) \p"
	.string "{FONT_MALE}{COLOR 0x02}{SHADOW 0x03}除了为你自己的宝可梦\n"
	.string "祈求幸福外……\p"
	.string "……我能请求你替\n"
	.string "所有的宝可梦祈求幸福吗？$"

gFameCheckerPersonName_Giovanni:: @ 0x81B0BA6
	.string "{COLOR 0x08}{SHADOW 0x09}坂木$"

gFameCheckerPersonQuote_Giovanni:: @ 0x81B0BB5
	.string "{COLOR 0x08}{SHADOW 0x09}坂木 (寄) \n"
	.string "{PLAYER} (收) \p"
	.string "{FONT_MALE}{COLOR 0x02}{SHADOW 0x03}我没有什么\n"
	.string "要跟你说的。\p"
	.string "我只要专于继续令自己变强，\n"
	.string "也就没有其它的什么了。$"

